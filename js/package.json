{
  "name": "slay3r-integration",
  "version": "0.1.0",
  "description": "Tests to verify slay3r + cometbft plays well with CosmJS",
  "main": "index.js",
  "scripts": {
    "lint": "eslint --max-warnings 0 \"./src/**/*.ts\" \"./*.js\"",
    "lint-fix": "eslint --fix --max-warnings 0 \"./src/**/*.ts\" \"./*.js\"",
    "format": "prettier --write --loglevel warn \"./src/**/*.ts\"",
    "format-text": "prettier --write \"./*.md\"",
    "build": "rm -rf ./build && tsc",
    "ts-test": "ts-node node_modules/jasmine/bin/jasmine",
    "test": "npm run build && node jasmine-testrunner.js",
    "tap-faucet": "ts-node src/tap-faucet.ts"
  },
  "author": "",
  "license": "CC-BY-NC-ND-4.0",
  "dependencies": {
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/cosmwasm-stargate": "^0.32.4",
    "@cosmjs/faucet-client": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "@cosmjs/tendermint-rpc": "^0.32.4",
    "@cosmjs/utils": "^0.32.4",
    "@types/eslint-plugin-prettier": "^3.1.0",
    "@types/jasmine": "^4.3.1",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "cosmjs-types": "^0.9.0",
    "eslint": "^8.41.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-import-resolver-node": "^0.3.7",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "jasmine": "^5.0.0",
    "jasmine-spec-reporter": "^7.0.0",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4"
  }
}
