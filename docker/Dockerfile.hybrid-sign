# docker build . -f docker/Dockerfile.hybrid-sign -t junoclaw-hybrid-sign:latest
# Produces /out/hybrid-sign — hybrid secp256k1+MAYO signer for JunoClaw txs.
# Run e.g.:
#   docker run --rm junoclaw-hybrid-sign:latest keygen --variant mayo2
#   docker run --rm -v ${PWD}/out:/out junoclaw-hybrid-sign:latest \
#       sign --variant mayo2 --secp-sk <hex> --mayo-sk <hex> \
#            --to juno1... --amount 1000 --sequence 0 --out /out/tx.hex
# Then broadcast on the host:
#   cargo run -p tx-sender -- broadcast --tx-file out/tx.hex

FROM rust:1.97-bookworm
WORKDIR /w

# cmake + C toolchain for sriracha-mayo's MAYO-C build.
RUN apt update && apt install -y cmake clang g++

# Workspace root manifests — hybrid-sign is excluded from the workspace but its
# path deps (layer-std, layer-proto) inherit `workspace = true` fields that are
# resolved against this root.
COPY Cargo.lock Cargo.toml /w/
COPY .cargo/config.toml /w/.cargo/config.toml

# CosmWasm fork submodule (patched via [patch.crates-io] in workspace Cargo.toml).
COPY lib/cosmwasm/Cargo.toml /w/lib/cosmwasm/Cargo.toml
COPY lib/cosmwasm/Cargo.lock /w/lib/cosmwasm/Cargo.lock
COPY lib/cosmwasm/packages /w/lib/cosmwasm/packages

# Member manifests for workspace resolution (dummy src is enough — these are
# not in hybrid-sign's dep graph).
COPY app/slay3rd/Cargo.toml /w/app/slay3rd/Cargo.toml
COPY dummy.rs /w/app/slay3rd/src/main.rs
COPY contracts/caller/Cargo.toml /w/contracts/caller/Cargo.toml
COPY dummy.rs /w/contracts/caller/src/lib.rs
COPY contracts/echo/Cargo.toml /w/contracts/echo/Cargo.toml
COPY dummy.rs /w/contracts/echo/src/lib.rs
COPY contracts/light-client/Cargo.toml /w/contracts/light-client/Cargo.toml
COPY dummy.rs /w/contracts/light-client/src/lib.rs
COPY packages/app/Cargo.toml /w/packages/app/Cargo.toml
COPY dummy.rs /w/packages/app/src/lib.rs
COPY packages/cosmos/Cargo.toml /w/packages/cosmos/Cargo.toml
COPY dummy.rs /w/packages/cosmos/src/lib.rs
COPY packages/storage/Cargo.toml /w/packages/storage/Cargo.toml
COPY dummy.rs /w/packages/storage/src/lib.rs
COPY tools/tx-sender/Cargo.toml /w/tools/tx-sender/Cargo.toml
COPY dummy.rs /w/tools/tx-sender/src/main.rs
COPY tools/bls-relayer/Cargo.toml /w/tools/bls-relayer/Cargo.toml
COPY dummy.rs /w/tools/bls-relayer/src/main.rs

# REAL sources for everything in hybrid-sign's dependency graph:
#   hybrid-sign -> layer-std, layer-proto
#   layer-std   -> junoclaw-mayo-verify, layer-root (contracts/root)
#   layer-proto -> layer-std
COPY packages/std /w/packages/std
COPY packages/proto /w/packages/proto
COPY packages/junoclaw-mayo-verify /w/packages/junoclaw-mayo-verify
COPY contracts/root /w/contracts/root

# The tool itself (excluded from workspace — builds standalone).
COPY tools/hybrid-sign /w/tools/hybrid-sign
RUN cargo build --release --manifest-path /w/tools/hybrid-sign/Cargo.toml

### PRODUCTION
FROM debian:bookworm-slim
COPY --from=0 /w/tools/hybrid-sign/target/release/hybrid-sign /usr/local/bin/hybrid-sign
ENTRYPOINT ["hybrid-sign"]
