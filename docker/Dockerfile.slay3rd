# docker build . -f docker/Dockerfile.slay3rd -t junoclaw-chain:latest
# docker run --rm -it junoclaw-chain:latest /bin/bash

### BUILDING

FROM rust:1.97-bookworm AS builder
WORKDIR /myapp

RUN apt update && apt install -y clang

# wasmer 4.3.7 references __rust_probestack which was removed from Rust stdlib.
# Provide a shim so the linker can resolve the symbol.
COPY docker/shim.c /tmp/shim.c
RUN cc -c -o /tmp/shim.o /tmp/shim.c
ENV RUSTFLAGS="-C link-arg=/tmp/shim.o"

# This whole pile will pre-build and cache the dependencies, so we just recompile local code below
COPY Cargo.lock Cargo.toml /myapp/
COPY .cargo/config.toml /myapp/.cargo/config.toml

# CosmWasm fork submodule (patched via [patch.crates-io] in workspace Cargo.toml).
# Copy REAL sources — external crates (cw-utils, cw2, ...) compile against
# cosmwasm-std / cosmwasm-schema, so they cannot be stubbed with dummy lib.rs.
# (lib/cosmwasm/target is excluded via .dockerignore **/target/.)
COPY lib/cosmwasm/Cargo.toml /myapp/lib/cosmwasm/Cargo.toml
COPY lib/cosmwasm/Cargo.lock /myapp/lib/cosmwasm/Cargo.lock
COPY lib/cosmwasm/packages /myapp/lib/cosmwasm/packages

# Workspace member Cargo.tomls with dummy source for dependency caching
COPY app/slay3rd/Cargo.toml /myapp/app/slay3rd/Cargo.toml
COPY dummy.rs /myapp/app/slay3rd/src/main.rs
COPY contracts/caller/Cargo.toml /myapp/contracts/caller/Cargo.toml
COPY dummy.rs /myapp/contracts/caller/src/lib.rs
COPY contracts/echo/Cargo.toml /myapp/contracts/echo/Cargo.toml
COPY dummy.rs /myapp/contracts/echo/src/lib.rs
COPY contracts/root/Cargo.toml /myapp/contracts/root/Cargo.toml
COPY dummy.rs /myapp/contracts/root/src/lib.rs
COPY contracts/light-client/Cargo.toml /myapp/contracts/light-client/Cargo.toml
COPY dummy.rs /myapp/contracts/light-client/src/lib.rs
COPY packages/app/Cargo.toml /myapp/packages/app/Cargo.toml
COPY dummy.rs /myapp/packages/app/src/lib.rs
COPY packages/cosmos/Cargo.toml /myapp/packages/cosmos/Cargo.toml
COPY dummy.rs /myapp/packages/cosmos/src/lib.rs
COPY packages/proto/Cargo.toml /myapp/packages/proto/Cargo.toml
COPY dummy.rs /myapp/packages/proto/src/lib.rs
COPY dummy.rs /myapp/packages/proto/examples/sync_test.rs
COPY packages/std/Cargo.toml /myapp/packages/std/Cargo.toml
COPY dummy.rs /myapp/packages/std/src/lib.rs
COPY packages/storage/Cargo.toml /myapp/packages/storage/Cargo.toml
COPY dummy.rs /myapp/packages/storage/src/lib.rs
COPY tools/tx-sender/Cargo.toml /myapp/tools/tx-sender/Cargo.toml
COPY dummy.rs /myapp/tools/tx-sender/src/main.rs
COPY tools/bls-relayer/Cargo.toml /myapp/tools/bls-relayer/Cargo.toml
COPY dummy.rs /myapp/tools/bls-relayer/src/main.rs
RUN cargo build --release --bin slay3rd

# clean up these fake local deps so we compile for real later
RUN find /myapp -name "*.rs" -path "*/src/*" -not -path "*/lib/cosmwasm/*" -delete
RUN rm -rf target/release/.fingerprint/layer-* target/release/.fingerprint/slay3rd-*

# This build step should just compile the local code and be faster
COPY . .
RUN cargo build --release --bin slay3rd

### PRODUCTION

# Now, pack up that binary in a nice small image
FROM debian:bookworm-slim
RUN apt-get update && apt-get upgrade -y
RUN apt install -y libcurl4 wget
COPY --from=builder /myapp/target/release/slay3rd /usr/local/bin/slay3rd
EXPOSE 26658
CMD ["slay3rd"]

